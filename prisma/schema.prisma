datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// -------------------------------------------------------------
// BETTER AUTH CORE MODELS
// -------------------------------------------------------------
model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          String       @default("user") // "user" | "admin"
  institution   String?
  country       String?
  whatsapp      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions      Session[]
  accounts      Account[]
  teamMembers   TeamMember[]
  claimedSets   ImageSet[]
  joinRequests  TeamJoinRequest[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  expiresAt             DateTime?
  issuer                String?

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// -------------------------------------------------------------
// ASTEROID CAMPAIGN & TEAM WORKSPACE MODELS
// -------------------------------------------------------------
enum EventStatus {
  UPCOMING
  ACTIVE
  SUBMISSION_OPEN
  COMPLETED
}

enum TeamStatus {
  FORMING
  ACTIVE
  SUBMITTED
  DISQUALIFIED
}

model Event {
  id                 String      @id @default(cuid())
  title              String
  code               String      @unique // e.g. "AST-2026-A"
  description        String?
  regStart           DateTime?
  regEnd             DateTime?
  teamFormationStart DateTime?
  teamFormationEnd   DateTime?
  startDate          DateTime?
  endDate            DateTime?
  submissionStart    DateTime?
  submissionEnd      DateTime?
  maxTeamSize            Int?        // Null = unlimited squad size
  maxTeams               Int?        // Null = unlimited teams in campaign
  status                 EventStatus @default(UPCOMING)
  discordRoleId          String?     // Specific campaign role ID (e.g. SEDS-2026-A)
  discordAlertsChannelId String?     // Channel ID for discovery alerts & campaign announcements
  discordSquadsChannelId String?     // Channel ID for squad recruitments & formations
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  teams              Team[]
  imageSets          ImageSet[]

  @@map("event")
}

model Team {
  id               String       @id @default(cuid())
  eventId          String
  name             String
  inviteCode       String       @unique // Short 6-char shareable code e.g. "AST-X9Y"
  status           TeamStatus   @default(FORMING)
  isRecruiting           Boolean      @default(true) // Open for solo student matching
  recruitmentNotes       String?
  disqualificationReason String?      // Admin moderation reason if team is disabled/disqualified
  leaderId               String // User ID of Team Creator / Leader
  discordThreadId        String?      // Private Discord Thread ID for this squad
  discordThreadUrl       String?      // Direct link to open Discord Thread
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members          TeamMember[]
  imageSets        ImageSet[]
  joinRequests     TeamJoinRequest[]

  @@map("team")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("member") // "leader" | "member"
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_member")
}

model TeamJoinRequest {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  message   String?
  status    String   @default("PENDING") // "PENDING" | "ACCEPTED" | "REJECTED"
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("team_join_request")
}

model ImageSet {
  id            String    @id @default(cuid())
  eventId       String
  teamId        String?
  claimedById   String?
  name          String // e.g. "SET-0492"
  fitsUrl       String? // Link to FITS image archive
  status        String    @default("UNASSIGNED") // "UNASSIGNED" | "IN_PROGRESS" | "SUBMITTED"
  mpcReportText String? // MPC 80-column discovery format text
  isClean       Boolean   @default(false) // True if team verified no asteroids found
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team          Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  claimedBy     User?     @relation(fields: [claimedById], references: [id], onDelete: SetNull)

  @@map("image_set")
}
